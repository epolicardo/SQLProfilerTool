# Source TypeScript files and build artifacts
src/**
out/**
.vscode/**
.vscode-test/**

# Keep only bundled distribution
!dist/**

# Keep webview files in source (will be bundled)
!src/webview/**/*.css
!src/webview/**/*.js
!src/webview/**/*.html

# Build configuration files
tsconfig.json
.eslintrc.json
webpack.config.js

# Documentation
Documentation/**
*.md
!README.md
!CHANGELOG.md
!LICENSE

# Test files
test-*.sql
diagnostic-*.sql
debug-*.md

# Git
.git
.gitignore
.github

# Development
node_modules/**/.bin
*.vsix
*.code-workspace
*.log

# Scripts
scripts/**

# Old releases
sql-server-profiler-tool-*.vsix
sql-server-profiler-tool-*/**

# Debug and temp files
profiler-results.json
vscode-app-*.log

# Keep only necessary files
!out/**
!resources/**
!LICENSE
!README.md
!package.json
!CHANGELOG.md
