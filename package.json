{
    "name": "sql-server-profiler-tool",
    "displayName": "SQL Server Profiler Tool",
    "description": "SQL Server profiler extension using Extended Events for real-time query capture and analysis",
    "version": "0.6.0",
    "publisher": "epolicardo",
    "license": "MIT",
    "icon": "icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/epolicardo/SQLProfilerTool.git"
    },
    "homepage": "https://github.com/epolicardo/SQLProfilerTool#readme",
    "bugs": {
        "url": "https://github.com/epolicardo/SQLProfilerTool/issues"
    },
    "engines": {
        "vscode": "^1.74.0"
    },
    "categories": [
        "Other",
        "Visualization"
    ],
    "keywords": [
        "sql server",
        "profiler",
        "extended events",
        "database",
        "performance"
    ],
    "activationEvents": [],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "sqlProfiler.startProfiling",
                "title": "Start SQL Server Profiling",
                "category": "SQL Profiler",
                "icon": "$(play)"
            },
            {
                "command": "sqlProfiler.stopProfiling",
                "title": "Stop SQL Server Profiling",
                "category": "SQL Profiler",
                "icon": "$(debug-stop)"
            },
            {
                "command": "sqlProfiler.openProfiler",
                "title": "Open SQL Server Profiler",
                "category": "SQL Profiler",
                "icon": "$(database)"
            },
            {
                "command": "sqlProfiler.clearResults",
                "title": "Clear Profiler Results",
                "category": "SQL Profiler",
                "icon": "$(clear-all)"
            },
            {
                "command": "sqlProfiler.manageConnections",
                "title": "Manage Database Connections",
                "category": "SQL Profiler",
                "icon": "$(server-environment)"
            },
            {
                "command": "sqlProfiler.showLogs",
                "title": "Show SQL Profiler Logs",
                "category": "SQL Profiler",
                "icon": "$(output)"
            },
            {
                "command": "sqlProfiler.clearStoredPassword",
                "title": "Clear Stored Password",
                "category": "SQL Profiler",
                "icon": "$(key)"
            },
            {
                "command": "sqlProfiler.clearAllStoredPasswords",
                "title": "Clear All Stored Passwords",
                "category": "SQL Profiler",
                "icon": "$(trash)"
            },
            {
                "command": "sqlProfiler.showStoredPasswords",
                "title": "Show Connections with Stored Passwords",
                "category": "SQL Profiler",
                "icon": "$(list-unordered)"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "sqlProfiler.startProfiling"
                },
                {
                    "command": "sqlProfiler.stopProfiling"
                },
                {
                    "command": "sqlProfiler.openProfiler"
                },
                {
                    "command": "sqlProfiler.clearResults"
                },
                {
                    "command": "sqlProfiler.manageConnections"
                },
                {
                    "command": "sqlProfiler.showLogs"
                },
                {
                    "command": "sqlProfiler.clearStoredPassword"
                },
                {
                    "command": "sqlProfiler.clearAllStoredPasswords"
                },
                {
                    "command": "sqlProfiler.showStoredPasswords"
                }
            ]
        },
        "configuration": {
            "title": "SQL Server Profiler Tool",
            "properties": {
                "sqlProfiler.sessionName": {
                    "type": "string",
                    "default": "VSCodeProfilerSession",
                    "description": "Prefix for profiler-owned Extended Events session names"
                },
                "sqlProfiler.autoStart": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically start profiling when opening SQL files"
                },
                "sqlProfiler.maxEvents": {
                    "type": "number",
                    "default": 1000,
                    "minimum": 1,
                    "maximum": 10000,
                    "description": "Maximum number of events retained in memory"
                },
                "sqlProfiler.selectedConnection": {
                    "type": "string",
                    "default": "",
                    "description": "Name of the selected mssql connection profile for profiling"
                },
                "sqlProfiler.verboseLogging": {
                    "type": "boolean",
                    "default": false,
                    "description": "Write detailed diagnostic logs to the 'SQL Server Profiler' output channel. Enable this before reproducing an issue for a bug report. These logs stay on your machine and are never transmitted."
                },
                "sqlProfiler.connectionString": {
                    "type": "string",
                    "default": "",
                    "markdownDeprecationMessage": "Deprecated: connection strings are now stored in VS Code SecretStorage. Any value set here is migrated to SecretStorage on first use and then cleared.",
                    "description": "Deprecated legacy connection string. Use an mssql connection profile instead."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run check-types && npm run lint && npm run bundle -- --minify",
        "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node16 --external:vscode --outfile=dist/extension.js --sourcemap",
        "compile": "npm run check-types && npm run bundle",
        "check-types": "tsc -p ./ --noEmit",
        "watch": "npm run bundle -- --watch",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "package": "npm run check-types && npm run lint && npm run bundle -- --minify && vsce package --no-dependencies"
    },
    "devDependencies": {
        "@types/mssql": "^9.1.8",
        "@types/node": "^16.18.126",
        "@types/tedious": "^18.0.0",
        "@types/vscode": "^1.74.0",
        "@typescript-eslint/eslint-plugin": "^5.45.0",
        "@typescript-eslint/parser": "^5.45.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.24.0",
        "eslint": "^8.28.0",
        "typescript": "^4.9.4"
    },
    "dependencies": {
        "mssql": "^9.1.1"
    }
}
