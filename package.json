{
  "name": "sql-server-profiler-tool",
  "displayName": "SQL Server Profiler Tool",
  "description": "SQL Server profiler extension using Extended Events for real-time query capture and analysis with advanced connection pooling, auto-reconnection system, and persistent UI state",
  "icon": "resources/Designer.png",
  "version": "0.5.0",
  "publisher": "epolicardo",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "sql server",
    "profiler",
    "extended events",
    "database",
    "performance",
    "auto-reconnection",
    "connection pooling",
    "circuit breaker",
    "azure sql",
    "reliability"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "SQL Server Profiler Tool",
      "properties": {
        "sqlProfiler.connectionString": {
          "type": "string",
          "default": "",
          "description": "SQL Server connection string",
          "scope": "resource"
        },
        "sqlProfiler.sessionName": {
          "type": "string",
          "default": "VSCodeProfilerSession",
          "description": "Extended Events session name"
        },
        "sqlProfiler.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start profiling when opening SQL files"
        },
        "sqlProfiler.maxEvents": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of events to capture"
        },
        "sqlProfiler.selectedConnection": {
          "type": "string",
          "default": "",
          "description": "Name of the selected mssql connection profile for profiling"
        },
        "sqlProfiler.connectionPool": {
          "type": "object",
          "default": {
            "maxConnections": 5,
            "minConnections": 2,
            "idleTimeout": 60000,
            "acquireTimeout": 30000,
            "createTimeout": 30000,
            "healthCheck": true,
            "healthCheckInterval": 30000
          },
          "description": "Connection pool configuration",
          "properties": {
            "maxConnections": {
              "type": "number",
              "default": 5,
              "minimum": 1,
              "maximum": 20,
              "description": "Maximum number of connections in the pool"
            },
            "minConnections": {
              "type": "number",
              "default": 2,
              "minimum": 1,
              "maximum": 10,
              "description": "Minimum number of connections to maintain in the pool"
            },
            "idleTimeout": {
              "type": "number",
              "default": 60000,
              "minimum": 5000,
              "description": "Time in milliseconds after which idle connections are closed"
            },
            "acquireTimeout": {
              "type": "number",
              "default": 30000,
              "minimum": 5000,
              "description": "Time in milliseconds to wait for acquiring a connection"
            },
            "createTimeout": {
              "type": "number",
              "default": 30000,
              "minimum": 5000,
              "description": "Time in milliseconds to wait for creating a new connection"
            },
            "healthCheck": {
              "type": "boolean",
              "default": true,
              "description": "Enable automatic health checks for connections"
            },
            "healthCheckInterval": {
              "type": "number",
              "default": 30000,
              "minimum": 10000,
              "description": "Interval in milliseconds for health check execution"
            }
          }
        },
        "sqlProfiler.autoReconnect": {
          "type": "object",
          "default": {
            "maxRetries": 5,
            "initialDelay": 1000,
            "backoffFactor": 2,
            "maxDelay": 30000,
            "connectionTimeout": 15000,
            "enableCircuitBreaker": true,
            "circuitBreakerThreshold": 3,
            "circuitBreakerCooldown": 60000
          },
          "description": "Auto-reconnection system configuration",
          "properties": {
            "maxRetries": {
              "type": "number",
              "default": 5,
              "minimum": 1,
              "maximum": 20,
              "description": "Maximum number of reconnection attempts before giving up"
            },
            "initialDelay": {
              "type": "number",
              "default": 1000,
              "minimum": 100,
              "maximum": 10000,
              "description": "Initial delay between reconnection attempts in milliseconds"
            },
            "backoffFactor": {
              "type": "number",
              "default": 2,
              "minimum": 1,
              "maximum": 5,
              "description": "Exponential backoff factor for reconnection delays"
            },
            "maxDelay": {
              "type": "number",
              "default": 30000,
              "minimum": 1000,
              "maximum": 300000,
              "description": "Maximum delay between reconnection attempts in milliseconds"
            },
            "connectionTimeout": {
              "type": "number",
              "default": 15000,
              "minimum": 5000,
              "maximum": 60000,
              "description": "Timeout for each reconnection attempt in milliseconds"
            },
            "enableCircuitBreaker": {
              "type": "boolean",
              "default": true,
              "description": "Enable circuit breaker to prevent excessive reconnection attempts"
            },
            "circuitBreakerThreshold": {
              "type": "number",
              "default": 3,
              "minimum": 1,
              "maximum": 10,
              "description": "Number of consecutive failures before opening the circuit breaker"
            },
            "circuitBreakerCooldown": {
              "type": "number",
              "default": 60000,
              "minimum": 10000,
              "maximum": 600000,
              "description": "Time to wait before attempting to close the circuit breaker in milliseconds"
            }
          }
        },
        "sqlProfiler.profilerMode": {
          "type": "string",
          "enum": [
            "ads"
          ],
          "enumDescriptions": [
            "Azure Data Studio Profiler compatible mode - uses the same event capture and mapping as ADS (recommended)"
          ],
          "default": "ads",
          "markdownDescription": "**Event Capture Mode**:\n\n- `ads`: Azure Data Studio compatible mode - captures events using the same query logic as ADS Profiler (recommended)\n\n*Note: The 'default' mode is temporarily disabled and will be re-enabled in a future version after fixes*"
        },
        "sqlProfiler.telemetryEnabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "**Enable telemetry and OpenTelemetry instrumentation** for SQL Profiler Tool.\n\n✅ **Enabled by default** to help improve the extension.\n\n� **Telemetry data is sent to Azure Application Insights** using OpenTelemetry.\n\n🔒 **Privacy guaranteed**: All sensitive data (passwords, connection strings, SQL queries) is automatically sanitized. Only anonymous usage patterns and performance metrics are collected.\n\n💡 You can disable this at any time. Also respects VS Code's global telemetry settings."
        }
      }
    },
    "commands": [
      {
        "command": "sqlProfiler.startProfiling",
        "title": "Start SQL Server Profiling",
        "category": "SQL Profiler",
        "icon": "$(play)"
      },
      {
        "command": "sqlProfiler.stopProfiling",
        "title": "Stop SQL Server Profiling",
        "category": "SQL Profiler",
        "icon": "$(debug-stop)"
      },
      {
        "command": "sqlProfiler.openProfiler",
        "title": "Open SQL Server Profiler",
        "category": "SQL Profiler",
        "icon": "$(database)"
      },
      {
        "command": "sqlProfiler.changeProfilerMode",
        "title": "Change Profiler Capture Mode",
        "category": "SQL Profiler",
        "icon": "$(settings)"
      },
      {
        "command": "sqlProfiler.clearResults",
        "title": "Clear Profiler Results",
        "category": "SQL Profiler",
        "icon": "$(clear-all)"
      },
      {
        "command": "sqlProfiler.manageConnections",
        "title": "Manage Database Connections",
        "category": "SQL Profiler",
        "icon": "$(server-environment)"
      },
      {
        "command": "sqlProfiler.showLogs",
        "title": "Show SQL Profiler Logs",
        "category": "SQL Profiler",
        "icon": "$(output)"
      },
      {
        "command": "sqlProfiler.clearStoredPassword",
        "title": "Clear Stored Password",
        "category": "SQL Profiler",
        "icon": "$(key)"
      },
      {
        "command": "sqlProfiler.clearAllStoredPasswords",
        "title": "Clear All Stored Passwords",
        "category": "SQL Profiler",
        "icon": "$(trash)"
      },
      {
        "command": "sqlProfiler.showStoredPasswords",
        "title": "Show Connections with Stored Passwords",
        "category": "SQL Profiler",
        "icon": "$(list-unordered)"
      },
      {
        "command": "sqlProfiler.showReconnectStats",
        "title": "Show Auto-Reconnection Statistics",
        "category": "SQL Profiler",
        "icon": "$(pulse)"
      },
      {
        "command": "sqlProfiler.resetCircuitBreaker",
        "title": "Reset Connection Circuit Breaker",
        "category": "SQL Profiler",
        "icon": "$(debug-restart)"
      },
      {
        "command": "sqlProfiler.configureAutoReconnect",
        "title": "Configure Auto-Reconnection Settings",
        "category": "SQL Profiler",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sqlProfiler.startWithAutoRecovery",
        "title": "Start Profiling with Enhanced Auto-Recovery",
        "category": "SQL Profiler",
        "icon": "$(shield)"
      },
      {
        "command": "sqlProfiler.diagnoseAzureSQL",
        "title": "Diagnose Azure SQL Database Connection",
        "category": "SQL Profiler",
        "icon": "$(pulse)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sqlProfiler",
          "title": "SQL Profiler",
          "icon": "resources/Designer.png"
        }
      ]
    },
    "views": {
      "sqlProfiler": [
        {
          "id": "sqlProfiler.sidebar",
          "name": "Profiler"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sqlProfiler.sidebar",
        "contents": "[Open SQL Server Profiler](command:sqlProfiler.openProfiler)"
      },
      {
        "view": "sqlProfiler.sidebar",
        "contents": "[Start Profiling](command:sqlProfiler.startProfiling)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sqlProfiler.startProfiling"
        },
        {
          "command": "sqlProfiler.stopProfiling"
        },
        {
          "command": "sqlProfiler.openProfiler"
        },
        {
          "command": "sqlProfiler.clearResults"
        },
        {
          "command": "sqlProfiler.manageConnections"
        },
        {
          "command": "sqlProfiler.showLogs"
        },
        {
          "command": "sqlProfiler.clearStoredPassword"
        },
        {
          "command": "sqlProfiler.clearAllStoredPasswords"
        },
        {
          "command": "sqlProfiler.showStoredPasswords"
        },
        {
          "command": "sqlProfiler.showReconnectStats"
        },
        {
          "command": "sqlProfiler.resetCircuitBreaker"
        },
        {
          "command": "sqlProfiler.configureAutoReconnect"
        },
        {
          "command": "sqlProfiler.startWithAutoRecovery"
        },
        {
          "command": "sqlProfiler.diagnoseAzureSQL"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package-vsce": "npx @vscode/vsce package",
    "package-hotfix": "node scripts/increment-and-package.js",
    "publish": "npx @vscode/vsce publish",
    "clean": "rimraf out dist",
    "rebuild": "npm run clean && npm run compile"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/epolicardo/SQLProfilerTool.git"
  },
  "bugs": {
    "url": "https://github.com/epolicardo/SQLProfilerTool/issues"
  },
  "homepage": "https://github.com/epolicardo/SQLProfilerTool#readme",
  "license": "MIT",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.8",
    "@types/node": "^16.18.126",
    "@types/tedious": "^18.0.0",
    "@types/vscode": "^1.106.1",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/vsce": "^3.2.0",
    "eslint": "^8.28.0",
    "glob": "^8.0.3",
    "rimraf": "^3.0.2",
    "ts-loader": "^9.5.4",
    "typescript": "^4.9.4",
    "webpack": "^5.105.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@azure/monitor-opentelemetry": "^1.9.0",
    "@opentelemetry/api": "^1.9.0",
    "@vscode/extension-telemetry": "^1.2.0",
    "mssql": "^9.1.1"
  }
}
